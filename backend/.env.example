# Local development environment
# Copy this file to .env and fill in values
# NEVER commit .env to Git

# ── Local PostgreSQL ──────────────────────────────────────
DB_NAME=marketintel
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Django ────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Email ─────────────────────────────────────────────────
MAIL_CREDENTIALS_ENCRYPTION_KEY=

EMAIL_TRACKING_BASE_URL=http://localhost:8000
EMAIL_OPEN_TRACKING_ENABLED=true

# Email recipient verification method.
# none       — syntax + MX lookup only (safe for Vercel, no port 25 needed)
# smtp_local — also probe SMTP port 25 (local dev only, requires port 25 access)
EMAIL_VERIFICATION_PROVIDER=none

# ── CORS / CSRF ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ── Production database (Supabase / any PostgreSQL URL) ───
# Leave empty for local — only set in Vercel environment
DATABASE_URL=

# ── Object storage (Cloudflare R2 / AWS S3) ──────────────
# Set USE_OBJECT_STORAGE=true in production when S3 is configured
USE_OBJECT_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ── Optional ──────────────────────────────────────────────
GEMINI_API_KEY=
